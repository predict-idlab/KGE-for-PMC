@prefix : <http://www.w3.org/2000/01/rdf-schema#> .
@prefix expr: <http://www.daml.org/services/owl-s/1.1/generic/Expression.owl#> .
@prefix owls: <http://www.daml.org/services/owl-s/1.1/Process.owl#> .
@prefix pmc: <https://pmc/classes/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .

pmc:PMCActuation a :Class ;
    :subClassOf ( ssn:Actuation ) .

pmc:PMCActuationProcess a :Class ;
    :subClassOf ( pmc:PMCProcess ) .

pmc:PMCActuationStep a :Class ;
    :subClassOf ( pmc:PMCDirectStep ) .

pmc:PMCCondition a :Class ;
    :subClassOf ( expr:Condition ) .

pmc:PMCConditionalStep a :Class ;
    :subClassOf ( pmc:PMCStep owls:If-Then-Else ) .

pmc:PMCDirectStep a :Class ;
    :subClassOf ( pmc:PMCStep ) .

pmc:PMCModule a :Class ;
    :subClassOf ( pmc:PMCStep owls:Sequence ) .

pmc:PMCObservation a :Class ;
    :subClassOf ( ssn:Observation ) .

pmc:PMCObservationProcess a :Class ;
    :subClassOf ( pmc:PMCProcess ) .

pmc:PMCObservationStep a :Class ;
    :subClassOf ( pmc:PMCDirectStep ) .

pmc:PMCProcess a :Class ;
    :subClassOf ( ssn:Procedure owls:Process ) .

pmc:PMCSampling a :Class ;
    :subClassOf ( ssn:Sampling ) .

pmc:PMCSamplingProcess a :Class ;
    :subClassOf ( pmc:PMCProcess ) .

pmc:PMCSamplingStep a :Class ;
    :subClassOf ( pmc:PMCDirectStep ) .

pmc:PMCStep a :Class ;
    :subClassOf ( owls:ControlConstruct ) .

pmc:begin a rdf:Property .

pmc:contains a rdf:Property .

pmc:end a rdf:Property .

pmc:followedBy a rdf:Property .

pmc:inModule a rdf:Property .

pmc:usedToMake a rdf:Property .

