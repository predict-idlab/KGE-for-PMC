@prefix : <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix expr: <http://www.daml.org/services/owl-s/1.1/generic/Expression.owl#> .
@prefix owls: <http://www.daml.org/services/owl-s/1.1/Process.owl#> .
@prefix pmc: <https://pmc/classes/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:DateTimeShape a :NodeShape ;
    :targetClass xsd:dateTime .

ex:FeatureOfInterestShape a :NodeShape ;
    :targetClass ssn:FeatureOfInterest .

ex:LiteralShape a :NodeShape ;
    :targetClass <rdfs:Literal> .

ex:PMCActuationProcessShape a :NodeShape ;
    :property [ :class pmc:PMCActuation ;
            :name "actuation" ;
            :path pmc:usedToMake ] ;
    :targetClass pmc:PMCActuationProcess .

ex:PMCActuationShape a :NodeShape ;
    :property [ :class ssn:Result ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "result" ;
            :path ssn:hasResult ],
        [ :class xsd:dateTime ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "time" ;
            :path ssn:resultTime ],
        [ :class <rdfs:Literal> ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "simpleResult" ;
            :path ssn:hasSimpleResult ],
        [ :class ssn:FeatureOfInterest ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "feature" ;
            :path ssn:hasFeatureOfInterest ] ;
    :targetClass pmc:PMCActuation .

ex:PMCActuationStepShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :minCount 1 ;
            :name "nextStep" ;
            :path pmc:followedBy ],
        [ :class pmc:PMCActuationProcess ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "exec" ;
            :path owls:process ] ;
    :targetClass pmc:PMCActuationStep .

ex:PMCConditionShape a :NodeShape ;
    :property [ :class <rdfs:Literal> ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "body" ;
            :path expr:expressionBody ],
        [ :class <rdfs:Literal> ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "var" ;
            :path expr:expressionVariable ] ;
    :targetClass pmc:PMCCondition .

ex:PMCConditionalStepShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "thenStep" ;
            :path owls:then ],
        [ :class pmc:PMCStep ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "elseStep" ;
            :path owls:else ],
        [ :class pmc:PMCCondition ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "conditioned" ;
            :path owls:ifCondition ] ;
    :targetClass pmc:PMCConditionalStep .

ex:PMCDirectStepShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :minCount 1 ;
            :name "nextStep" ;
            :path pmc:followedBy ],
        [ :class pmc:PMCProcess ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "exec" ;
            :path owls:process ] ;
    :targetClass pmc:PMCDirectStep .

ex:PMCModuleShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "begin" ;
            :path pmc:begin ],
        [ :class pmc:PMCStep ;
            :minCount 1 ;
            :name "contains" ;
            :path pmc:contains ],
        [ :class pmc:PMCStep ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "end" ;
            :path pmc:end ] ;
    :targetClass pmc:PMCModule .

ex:PMCObservationProcessShape a :NodeShape ;
    :property [ :class pmc:PMCObservation ;
            :name "observation" ;
            :path pmc:usedToMake ] ;
    :targetClass pmc:PMCObservationProcess .

ex:PMCObservationShape a :NodeShape ;
    :property [ :class ssn:Result ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "result" ;
            :path ssn:hasResult ],
        [ :class xsd:dateTime ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "time" ;
            :path ssn:resultTime ],
        [ :class <rdfs:Literal> ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "simpleResult" ;
            :path ssn:hasSimpleResult ],
        [ :class ssn:FeatureOfInterest ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "feature" ;
            :path ssn:hasFeatureOfInterest ] ;
    :targetClass pmc:PMCObservation .

ex:PMCObservationStepShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :minCount 1 ;
            :name "nextStep" ;
            :path pmc:followedBy ],
        [ :class pmc:PMCObservationProcess ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "exec" ;
            :path owls:process ] ;
    :targetClass pmc:PMCObservationStep .

ex:PMCProcessShape a :NodeShape ;
    :targetClass pmc:PMCProcess .

ex:PMCSamplingProcessShape a :NodeShape ;
    :property [ :class pmc:PMCSampling ;
            :name "sampling" ;
            :path pmc:usedToMake ] ;
    :targetClass pmc:PMCSamplingProcess .

ex:PMCSamplingShape a :NodeShape ;
    :property [ :class <rdfs:Literal> ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "simpleResult" ;
            :path ssn:hasSimpleResult ],
        [ :class xsd:dateTime ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "time" ;
            :path ssn:resultTime ],
        [ :class ssn:Sample ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "result" ;
            :path ssn:hasResult ],
        [ :class ssn:FeatureOfInterest ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "feature" ;
            :path ssn:hasFeatureOfInterest ] ;
    :targetClass pmc:PMCSampling .

ex:PMCSamplingStepShape a :NodeShape ;
    :property [ :class pmc:PMCStep ;
            :minCount 1 ;
            :name "nextStep" ;
            :path pmc:followedBy ],
        [ :class pmc:PMCSamplingProcess ;
            :maxCount 1 ;
            :minCount 1 ;
            :name "exec" ;
            :path owls:process ] ;
    :targetClass pmc:PMCSamplingStep .

ex:PMCStepShape a :NodeShape ;
    :property [ :class pmc:PMCModule ;
            :maxCount 1 ;
            :minCount 0 ;
            :name "inModule" ;
            :path pmc:inModule ] ;
    :targetClass pmc:PMCStep .

ex:ResultShape a :NodeShape ;
    :targetClass ssn:Result .

ex:SampleShape a :NodeShape ;
    :targetClass ssn:Sample .

